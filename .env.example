# Copie para .env e preencha. O .env não é versionado.

# --- LLM (qualquer endpoint compatível com a API da OpenAI) ---
# Padrão: camada gratuita do Groq. Chave em https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30
# Alternativa local, sem chave (precisa do Ollama rodando e do modelo baixado):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2:3b

# --- Loja ---
# Fixa a data "de hoje" da loja (AAAA-MM-DD) para demonstrar prazos de pedidos antigos.
# Vazio = data real no fuso America/Campo_Grande.
STORE_TODAY=

# --- Histórico de conversa ---
HISTORY_DB_PATH=data/history.sqlite3
